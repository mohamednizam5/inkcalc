# Required: replace with your production MySQL connection URL.
# Use an external managed MySQL service or a separately secured local MySQL instance.
DATABASE_URL=mysql://INKCALC_USER:STRONG_PASSWORD@MYSQL_HOST:3306/inkcalc

# Required: generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET

# Required only when the application's owner/OAuth functionality is used.
# Set the values from the existing production service, or leave blank if those features are disabled.
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
VITE_APP_ID=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Set to a public fully-qualified domain name after adding its DNS A record to the Oracle VM.
# Leave as :80 for initial IP-based HTTP verification.
INKCALC_DOMAIN=:80

# Optional: pull an already built image instead of building from the Git checkout.
# INKCALC_IMAGE=ghcr.io/mohamednizam5/inkcalc:latest
